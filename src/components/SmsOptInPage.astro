---
// Public text opt-in page for carrier review. Shows the form's contact step without filling
// anything in, with the exact consent text the live form shows, and what happens after submit.
// With marketing consent on, it also shows the separate optional marketing box and its exact text.
import LegalLayout from "./LegalLayout.astro";
import { getSiteData } from "../site-data.js";
import { LEGAL_PATHS } from "../paths.js";
import { CARRIER, LEGAL_TITLES, legalTitle, legalWho } from "../legal";
import type { ContactConsent } from "../lead-form/logic";

export type Props = {
  standalone?: boolean;
  /** Path of a page with the live form. Default "/". */
  formPath?: string;
  /** Match the live form's button. Default "Get my free estimate". */
  submitLabel?: string;
  /** Match the live form: true when the form sets consentRequired (the SMS box must be checked). */
  consentRequired?: boolean;
  /** Match the live form: its separate contact consent box, if any. */
  contactConsent?: ContactConsent;
  /**
   * Match the live form's LeadForm marketingConsent. Default: on when site data has marketing
   * consent wording. false: the page describes no marketing box.
   */
  marketingConsent?: boolean;
};

const { standalone, formPath = "/", submitLabel = "Get my free estimate", consentRequired = false, contactConsent, marketingConsent } = Astro.props;
const contactRequired = contactConsent ? (contactConsent.required ?? true) : false;
const site = await getSiteData();
const marketing = marketingConsent === false ? null : site.marketingConsent;
const who = legalWho(site);
const name = site.client.name;
const phone = site.client.phoneDisplay;
const formUrl = Astro.site ? new URL(formPath, Astro.site).href : formPath;
const formLabel = formUrl.replace(/^https?:\/\//, "").replace(/\/$/, "") || "this site";
---

<LegalLayout title={legalTitle("smsOptIn", site)} heading={LEGAL_TITLES.smsOptIn} who={who} standalone={standalone}>
  <slot name="head" slot="head" />
  <p>
    Homeowners request service from {who} on our website form at <a href={formUrl}>{formLabel}</a>. The form asks for contact details and shows
    {
      contactConsent ? (
        <>
          two checkboxes: one to be contacted about their request by phone and email ({contactRequired ? "required to send the request" : "optional"}), and a separate, <strong>unchecked{consentRequired ? "" : ", optional"}</strong> text message consent checkbox{consentRequired ? " that must be checked to send the request" : ""}.
        </>
      ) : consentRequired ? (
        <>
          an <strong>unchecked</strong> text message consent checkbox that must be checked to send the request.
        </>
      ) : (
        <>
          an <strong>unchecked, optional</strong> consent checkbox.
        </>
      )
    }
    {
      marketing ? (
        <>
          The form also has a separate, <strong>unchecked, optional</strong> checkbox for marketing texts (offers and seasonal reminders), shown last. It is never required to send the request. We only send texts about the request to people who check the text message consent box, and only send marketing texts to people who check the marketing box.
        </>
      ) : (
        "We only text people who check the text message consent box."
      )
    }
  </p>
  <p class="gsk-legal-note">This is the form's contact step, exactly as homeowners see it:</p>
  <div class="gsk-optin-mock" aria-label="Copy of the request form's contact step" role="figure">
    <div class="gsk-optin-fields">
      {
        ["First name", "Mobile phone", "Zip code", "Email (optional)"].map((f) => (
          <div class="gsk-optin-field">
            <span>{f}</span>
            <span class="gsk-optin-input" />
          </div>
        ))
      }
    </div>
    {
      contactConsent && (
        <div class="gsk-consent gsk-contact-consent">
          <div class="gsk-consent-label">
            <span aria-hidden="true" class="gsk-consent-box" />
            <span class="gsk-consent-text">{contactConsent.text}</span>
          </div>
        </div>
      )
    }
    <div class="gsk-consent">
      <div class="gsk-consent-label">
        <span aria-hidden="true" class="gsk-consent-box"></span>
        <span class="gsk-consent-text" data-consent-version={site.consent.version}>{site.consent.text}</span>
      </div>
      <p class="gsk-consent-links">
        <a href={LEGAL_PATHS.terms}>SMS terms</a> and <a href={LEGAL_PATHS.privacy}>Privacy policy</a>
      </p>
    </div>
    {
      marketing && (
        <div class="gsk-consent gsk-marketing-consent">
          <div class="gsk-consent-label">
            <span aria-hidden="true" class="gsk-consent-box" />
            <span class="gsk-consent-text" data-marketing-consent-version={marketing.version}>
              {marketing.text}
            </span>
          </div>
        </div>
      )
    }
    <div class="gsk-legal-button">{submitLabel}</div>
  </div>
  <h2>After they submit</h2>
  <p>People who checked {marketing ? "the text message consent box" : "the box"} get one text right away, from {name}:</p>
  <p class="gsk-legal-quote">
    Hi Jamie, this is {name}. We got your request. We'll call you in a few minutes{phone ? ` from ${phone}` : ""}. You can also reply here. Reply STOP to opt out.
  </p>
  <p>
    {
      marketing
        ? "Later texts about the request are replies to their questions and reminders about the estimate appointment they booked. People who also checked the separate marketing box may get occasional offers and seasonal reminders, as that box says; people who left it unchecked never get marketing texts."
        : "Later texts are about that request only: replies to their questions and reminders about the estimate appointment they booked."
    }{" "}
    Message frequency varies. {CARRIER.rates} Reply STOP to opt out at any time, HELP for help.
  </p>
  <p>
    <a href={LEGAL_PATHS.terms}>Terms &amp; Conditions (SMS Terms)</a> | <a href={LEGAL_PATHS.privacy}>Privacy Policy</a>
  </p>
</LegalLayout>
