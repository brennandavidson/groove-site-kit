{
  "name": "groove-site-kit",
  "version": "0.3.0",
  "description": "Shared plumbing for Design Groove client sites: lead form, consent, tracker, legal pages, call numbers, site data.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brennandavidson/groove-site-kit.git"
  },
  "keywords": [
    "astro-component",
    "withastro"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./integration": {
      "types": "./src/integration.d.ts",
      "default": "./src/integration.js"
    },
    "./components": "./src/components/index.ts",
    "./components/*": "./src/components/*",
    "./react": "./src/lead-form/LeadForm.tsx",
    "./styles.css": "./src/styles/kit.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "astro": ">=7.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@astrojs/react": "7.1.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "astro": "7.4.0",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
